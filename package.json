{
  "name": "magnograbr-android-webextension",
  "version": "0.2.0",
  "private": true,
  "description": "MagnoGrabr Firefox Android WebExtension",
  "scripts": {
    "build": "node scripts/build.mjs",
    "android": "web-ext run --source-dir extension --target=firefox-android",
    "lint": "npm run build && web-ext lint --source-dir dist",
    "package": "npm run build && web-ext build --source-dir dist --artifacts-dir web-ext-artifacts --overwrite-dest",
    "test": "node --test"
  },
  "devDependencies": {
    "web-ext": "^10.7.0"
  },
  "overrides": {
    "shell-quote": "^1.12.0"
  }
}
